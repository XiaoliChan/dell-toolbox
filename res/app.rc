#include <windows.h>

#define VER_FILEVERSION 0,1,0,0
#define VER_FILEVERSION_STR "0.1.0.0\0"
#define VER_PRODUCTVERSION 0,1,0,0
#define VER_PRODUCTVERSION_STR "0.1.0\0"

1 VERSIONINFO
FILEVERSION    VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "dell-toolbox contributors"
      VALUE "FileDescription",  "Dell Toolbox"
      VALUE "FileVersion",      VER_FILEVERSION_STR
      VALUE "InternalName",     "dell-toolbox"
      VALUE "LegalCopyright",   "GPLv3"
      VALUE "ProductName",      "Dell Toolbox"
      VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
      VALUE "OriginalFilename", "dell-toolbox.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
