// Numeric resource id: Explorer shows the icon group with the lowest id. A
// bare IDI_ICON1 here would be an undefined macro (windows.h is included
// below) and silently produce a string-named resource the shell ignores.
1 ICON "dell-toolbox.ico"
#include <windows.h>

#define VER_FILEVERSION 1,1,1,0
#define VER_FILEVERSION_STR "1.1.1.0\0"
#define VER_PRODUCTVERSION 1,1,1,0
#define VER_PRODUCTVERSION_STR "1.1.1\0"

1 VERSIONINFO
FILEVERSION    VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "dell-toolbox contributors"
      VALUE "FileDescription",  "Dell Toolbox"
      VALUE "FileVersion",      VER_FILEVERSION_STR
      VALUE "InternalName",     "dell-toolbox"
      VALUE "LegalCopyright",   "GPLv3"
      VALUE "ProductName",      "Dell Toolbox"
      VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
      VALUE "OriginalFilename", "dell-toolbox.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
